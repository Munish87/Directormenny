# DM OS Environment Variables

# YouTube Data API v3 (server-only, never exposed to client)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE
# Multiple channels: YOUTUBE_CHANNEL_ID=UCabc123,UCdef456

# Optional: include Shorts (videos ≤60s) in the feed
# INCLUDE_SHORTS=true

# Email via Resend (for contact form)
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
CONTACT_EMAIL=menny@directormenny.com
RESEND_FROM_EMAIL=DM OS Booking <menny@directormenny.com>
